# A bare `proxy_pass http://hostname:port` resolves the hostname ONCE, when
# nginx starts, and caches that IP for the life of the process. On platforms
# where a service's backing container gets a new private IP on every
# redeploy (Railway included), that means: redeploy the backend alone, and
# nginx keeps sending traffic to the old, now-dead IP until nginx itself is
# restarted — which looks like the app being intermittently, mysteriously
# down. Routing proxy_pass through a variable forces nginx to re-resolve via
# this `resolver` on every request instead of caching indefinitely.
resolver ${RESOLVER_IP} valid=5s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # nginx defaults to a 1MB request body cap, which silently rejects any
    # real-world BRSR PDF (commonly tens of MB) before it ever reaches the
    # backend — the browser sees this as a bare "Failed to fetch", not a
    # readable error. Raise it, and give large-PDF parsing room to finish.
    client_max_body_size 50M;

    include /etc/nginx/auth.conf;

    location /api/ {
        # With a variable in proxy_pass, nginx stops doing its usual
        # location-prefix substitution and instead forwards the incoming URI
        # unchanged — so no /api/ suffix belongs here (that would double it
        # up into /api/api/... and 404 against the backend's real routes).
        set $backend_upstream "http://${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
